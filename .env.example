# Application
SHORTVIDEOCLI_APP_ENV=development

# Logging
SHORTVIDEOCLI_LOG_LEVEL=INFO
SHORTVIDEOCLI_LOG_FILE=logs/app.log

# Database
SHORTVIDEOCLI_DATABASE_URL=sqlite+aiosqlite:///shortvideocli.db

# YouTube Data API
SHORTVIDEOCLI_YOUTUBE_API_KEY=

# Optional YouTube Analytics OAuth
SHORTVIDEOCLI_YOUTUBE_CLIENT_ID=
SHORTVIDEOCLI_YOUTUBE_CLIENT_SECRET=

# Optional AI provider
SHORTVIDEOCLI_OPENAI_API_KEY=